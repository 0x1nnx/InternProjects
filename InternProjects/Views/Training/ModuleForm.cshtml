@model InternProjects.Models.TrainingModule
@{
    ViewData["Title"] = (string?)ViewData["Heading"] ?? "Модул";
    var formAction = (string?)ViewData["FormAction"] ?? "EditModule";
    bool isEdit = formAction == "EditModule";
}

<nav class="mb-3"><a asp-action="Manage">← Управление на съдържанието</a></nav>

<h3 class="mb-4">@ViewData["Heading"]</h3>

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="@formAction" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            @if (isEdit)
            {
                <input type="hidden" asp-for="Id" />
            }

            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Заглавие *</label>
                        <input asp-for="Title" class="form-control" placeholder="Напр.: Първи ден" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label">Кратко описание</label>
                        <input asp-for="Summary" class="form-control"
                               placeholder="Показва се на картата в списъка с модули" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label">Общи указания за модула</label>
                        <textarea asp-for="Content" class="form-control" rows="8"
                                  placeholder="Свободен текст. Празен ред разделя абзаците, ред започващ с „- “ става точка от списък."></textarea>
                        <div class="form-text">
                            Празен ред = нов абзац. Ред, който започва с <code>- </code>, се показва като точка от списък.
                        </div>
                    </div>

                    <div class="form-check mb-0">
                        <input asp-for="IsPublished" class="form-check-input" />
                        <label asp-for="IsPublished" class="form-check-label">Видим за стажантите</label>
                        <div class="form-text">Скритите модули се виждат само от администратори.</div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Запази</button>
                <a asp-action="Manage" class="btn btn-outline-secondary">Отказ</a>
                @if (isEdit)
                {
                    <a asp-action="Module" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Преглед</a>
                }
            </div>
        </form>

        @if (isEdit && Model.UpdateDate != null)
        {
            <p class="text-muted small mt-3">
                Последна промяна: @Model.UpdateDate.Value.ToString("dd.MM.yyyy HH:mm")
                @if (!string.IsNullOrWhiteSpace(Model.UpdatedByName))
                {
                    <text>от @Model.UpdatedByName</text>
                }
            </p>
        }
    </div>

    <div class="col-lg-5">
        @if (!isEdit)
        {
            <div class="alert alert-light border small mb-0">
                Секциите се добавят след като модулът бъде създаден.
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Секции</h5>
                <a asp-action="CreateSection" asp-route-moduleId="@Model.Id"
                   class="btn btn-sm btn-primary">+ Нова секция</a>
            </div>

            <div class="card">
                <div class="list-group list-group-flush">
                    @foreach (var sec in Model.Sections)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@sec.Title</div>
                                    <div class="text-muted small">
                                        @if (sec.Topics.Any())
                                        {
                                            <span>@sec.Topics.Count подточки · </span>
                                        }
                                        @if (string.IsNullOrWhiteSpace(sec.Content) && !sec.Topics.Any())
                                        {
                                            <span class="text-warning">без указания</span>
                                        }
                                        else
                                        {
                                            <span>попълнена</span>
                                        }
                                    </div>
                                </div>
                                <div class="text-nowrap">
                                    <form asp-action="MoveSection" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@sec.Id" />
                                        <input type="hidden" name="direction" value="up" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 px-1" title="Нагоре">↑</button>
                                    </form>
                                    <form asp-action="MoveSection" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@sec.Id" />
                                        <input type="hidden" name="direction" value="down" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 px-1" title="Надолу">↓</button>
                                    </form>
                                    <a asp-action="EditSection" asp-route-id="@sec.Id"
                                       class="btn btn-sm btn-outline-primary">Редакция</a>
                                    <form asp-action="DeleteSection" method="post" class="d-inline"
                                          onsubmit="return confirm('Секцията ще бъде изтрита заедно с подточките ѝ. Да продължа?');">
                                        <input type="hidden" name="id" value="@sec.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }

                    @if (!Model.Sections.Any())
                    {
                        <div class="list-group-item text-center text-muted py-4 small">
                            Няма секции в този модул.
                        </div>
                    }
                </div>
            </div>
        }

        <div class="mt-4">
            <partial name="_TrainingImageEditor" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/training-images.js" asp-append-version="true"></script>
}
