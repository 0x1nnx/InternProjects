@model List<InternProjects.Models.TrainingModule>
@{
    ViewData["Title"] = "Начално обучение";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2 class="mb-0">Начално обучение</h2>
    @if (isAdmin)
    {
        <a asp-action="Manage" class="btn btn-outline-primary">Управление на съдържанието</a>
    }
</div>
<p class="text-muted mb-4">Указания за работата в обектите, с клиентите и с вътрешните системи. Модулите могат да се четат в произволен ред.</p>

<div class="row g-3">
    @foreach (var module in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary rounded-pill">@module.SortOrder</span>
                        <h5 class="mb-0">@module.Title</h5>
                        @if (!module.IsPublished)
                        {
                            <span class="badge bg-warning text-dark">Скрит</span>
                        }
                    </div>

                    <p class="text-muted small flex-grow-1">@module.Summary</p>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">
                            @(module.Sections.Count == 1 ? "1 тема" : module.Sections.Count + " теми")
                        </span>
                        <a asp-action="Module" asp-route-id="@module.Id" class="btn btn-sm btn-primary">Отвори</a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card"><div class="card-body text-center text-muted py-5">
                Няма добавени модули.
            </div></div>
        </div>
    }
</div>
